{
  "name": "scrollmind",
  "productName": "ScrollMind",
  "version": "1.9.0",
  "description": "A quiet, infinite sheet for your pen display.",
  "private": true,
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "test:pen": "node --test tests/pen-contract-doc.test.mjs tests/pen-shortcuts.test.mjs tests/pen-input.test.mjs tests/pen-native.test.mjs tests/pen-helper.test.mjs && playwright test -g \"Pen button contract\"",
    "preflight": "npm test && npm run test:ui",
    "icon": "node tools/make-icon.mjs",
    "build:pen": "node tools/build-pen-helper.mjs",
    "build:mac": "npm run build:pen && electron-builder --mac --dir",
    "release:mac": "npm run build:pen && npm run preflight && node tools/release-mac.mjs",
    "release:win": "node tools/release-win.mjs --check && npm run preflight && node tools/release-win.mjs",
    "build:win": "electron-builder --win",
    "build:win:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "electron": "44.11.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.seancheren.scrollmind",
    "productName": "ScrollMind",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "Sean Cheren (2LGYTL3FSJ)",
      "target": "dir",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "preAutoEntitlements": false,
      "notarize": false,
      "extraResources": [
        {
          "from": "build/bin/scroll-pen",
          "to": "scroll-pen"
        }
      ]
    },
    "fileAssociations": [
      {
        "ext": "sm",
        "name": "ScrollMind Scroll",
        "role": "Editor",
        "mimeType": "application/x-scrollmind"
      }
    ],
    "forceCodeSigning": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ScrollMind-Setup-${version}.${ext}",
      "signExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "ScrollMind"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chere005",
        "repo": "ScrollMind"
      }
    ]
  },
  "author": "Sean Cheren",
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
